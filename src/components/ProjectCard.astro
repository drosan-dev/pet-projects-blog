---
import type { CollectionEntry } from 'astro:content';
import { withBase } from '../lib/urls';

interface Props { project: CollectionEntry<'projects'>; index?: number; }
const { project, index = 0 } = Astro.props;
const statusLabels = { idea: 'Идея', building: 'В работе', released: 'Запущен' };
---

<article class="card">
  <div class="meta">
    <span>0{index + 1}</span>
    <span>{statusLabels[project.data.status]}</span>
  </div>
  <div>
    <h3><a href={withBase(`projects/${project.id}`)}>{project.data.title}</a></h3>
    <p>{project.data.description}</p>
  </div>
  <ul aria-label="Технологии">
    {project.data.stack.map((item) => <li>{item}</li>)}
  </ul>
</article>

<style>
  .card { display: grid; grid-template-columns: 7rem 1fr auto; gap: 1.5rem; padding: 1.8rem 0; border-top: 1px solid var(--line); }
  .meta { display: flex; flex-direction: column; gap: .35rem; color: var(--muted); font-size: .8rem; text-transform: uppercase; letter-spacing: .08em; }
  h3 { margin: 0; font-size: clamp(1.55rem, 3vw, 2.35rem); }
  h3 a { text-decoration: none; }
  h3 a:hover { color: var(--accent); }
  p { margin: .55rem 0 0; color: var(--muted); }
  ul { display: flex; flex-wrap: wrap; justify-content: flex-end; gap: .45rem; margin: .2rem 0 0; padding: 0; list-style: none; }
  li { height: fit-content; padding: .25rem .55rem; border: 1px solid var(--line); border-radius: 99px; font-size: .78rem; }
  @media (max-width: 720px) { .card { grid-template-columns: 3rem 1fr; } ul { grid-column: 2; justify-content: flex-start; } }
</style>
