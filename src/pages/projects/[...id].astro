---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { withBase } from '../../lib/urls';

export async function getStaticPaths() {
  const projects = await getCollection('projects', ({ data }) => !data.draft);
  return projects.map((project) => ({ params: { id: project.id }, props: { project } }));
}

const { project } = Astro.props;
const { Content } = await render(project);
const date = project.data.publishedAt.toLocaleDateString('ru-RU', { day: 'numeric', month: 'long', year: 'numeric' });
const statusLabels = { idea: 'Идея', building: 'В работе', released: 'Запущен' };
---

<BaseLayout title={project.data.title} description={project.data.description}>
  <article>
    <header class="project-head">
      <a class="back" href={withBase('projects')}>Все проекты</a>
      <p class="eyebrow">{statusLabels[project.data.status]} · {date}</p>
      <h1>{project.data.title}</h1>
      <p class="lead">{project.data.description}</p>
      <div class="actions">
        {project.data.demo && <a class="button" href={project.data.demo}>Открыть демо</a>}
        {project.data.repository && <a class="button secondary" href={project.data.repository}>Исходный код</a>}
      </div>
      <ul>{project.data.stack.map((item) => <li>{item}</li>)}</ul>
    </header>
    <div class="prose"><Content /></div>
  </article>
</BaseLayout>

<style>
  .project-head { padding: 4rem 0 3rem; border-bottom: 1px solid var(--line); }
  .back { display: inline-block; margin-bottom: 3rem; color: var(--muted); }
  .lead { max-width: 760px; font-size: clamp(1.2rem, 2vw, 1.6rem); color: var(--muted); }
  .actions { display: flex; flex-wrap: wrap; gap: .75rem; margin-top: 2rem; }
  ul { display: flex; flex-wrap: wrap; gap: .5rem; margin: 2.5rem 0 0; padding: 0; list-style: none; }
  li { padding: .25rem .65rem; border: 1px solid var(--line); border-radius: 99px; font-size: .82rem; }
</style>
